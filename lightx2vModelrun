#!/usr/bin/env bash
set -Eeuo pipefail

CK_CONV3D_V1_IMAGE="compiler.hvat-ai.com:8001/lightx2vrocm/lightx2v-rocm:gfx1201-R9600-FP8-260813-CKConv3dV1-Hot28-B0B1-Fix1"
IMAGE="${IMAGE:-${CK_CONV3D_V1_IMAGE}}"
CONTAINER_NAME="${CONTAINER_NAME:-lightx2v-gfx1201}"
GPU_DEVICES="${GPU_DEVICES:-0,1}"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
RUN_REPO_DIR="${RUN_REPO_DIR:-${script_dir}}"

# Host model layout from /disk/ssd/difumodels-Dis. The container maps these
# directories into the lowercase layout expected by the GFX1201 configs.
MODEL_STORE="${MODEL_STORE:-/disk/ssd/difumodels-Dis}"
ENCODERS_DIR="${ENCODERS_DIR:-${MODEL_STORE}/Encoders}"
DISTILL_MODELS_DIR="${DISTILL_MODELS_DIR:-${MODEL_STORE}/Wan2.2-Distill-Models}"
WAN22_BASE_DIR="${WAN22_BASE_DIR:-${MODEL_STORE}/Wan2.2-I2V-A14B}"
WAN21_DISTILL_DIR="${WAN21_DISTILL_DIR:-${MODEL_STORE}/Wan2.1-I2V-14B-720P-StepDistill-CfgDistill-Lightx2v/distill_fp8}"
H3_MODEL_DIR="${H3_MODEL_DIR:-/disk/ssd1/difumodels/MiniMax-h3}"
H3_TURBO_DIR="${H3_TURBO_DIR:-/disk/ssd/difumodels-Dis/Minimax-h3-Turbo}"
LTX23_CHECKPOINT="${LTX23_CHECKPOINT:-${MODEL_STORE}/LTX-2.3-fp8/ltx-2.3-22b-distilled-fp8.safetensors}"
LTX23_UPSCALER="${LTX23_UPSCALER:-${MODEL_STORE}/LTX-2.3-fp8/ltx-2.3-spatial-upscaler-x2-1.1.safetensors}"
LTX23_GEMMA_DIR="${LTX23_GEMMA_DIR:-${MODEL_STORE}/LTX-2.3-fp8/gemma-3-12b-it-qat-q4_0-unquantized}"
LTX25_MODEL_ROOT="${LTX25_MODEL_ROOT:-${MODEL_STORE}/LTX-2.5}"

RUNTIME_ROOT="${RUNTIME_ROOT:-/disk/ssd/lightx2v-runtime}"
INPUT_DIR="${INPUT_DIR:-${RUNTIME_ROOT}/inputs}"
OUTPUT_DIR="${OUTPUT_DIR:-${RUNTIME_ROOT}/outputs}"
CACHE_DIR="${CACHE_DIR:-${RUNTIME_ROOT}/cache}"

readonly CONTAINER_MODELS_ROOT=/models
readonly CONTAINER_BASE_MODEL=/models/Wan-AI/Wan2.2-I2V-A14B
readonly CONTAINER_WAN21_DISTILL_MODEL=/models/lightx2v/Wan2.1-I2V-14B-720P-StepDistill-CfgDistill-Lightx2v/distill_fp8
readonly CONTAINER_H3_MODEL=/models/minimax_h3
readonly CONTAINER_H3_TURBO=/models/minimax_h3_turbo
readonly CONTAINER_H3_FIRST_FRAME=/inputs/minimax_h3_first_frame
readonly CONTAINER_H3_LAST_FRAME=/inputs/minimax_h3_last_frame
readonly CONTAINER_H3_IMAGE_FIRST_FRAME=/workspace/LightX2V/assets/inputs/imgs/flf2v_input_first_frame-fs8.png
readonly CONTAINER_H3_IMAGE_LAST_FRAME=/workspace/LightX2V/assets/inputs/imgs/flf2v_input_last_frame-fs8.png
readonly CONTAINER_LTX23_ROOT=/models/ltx23
readonly CONTAINER_LTX23_CHECKPOINT=/models/ltx23/checkpoints/ltx-2.3-22b-distilled-fp8.safetensors
readonly CONTAINER_LTX23_UPSCALER=/models/ltx23/upscaler/ltx-2.3-spatial-upscaler-x2-1.1.safetensors
readonly CONTAINER_LTX23_GEMMA=/models/ltx23/gemma
readonly CONTAINER_LTX25_TUNABLEOP_ROOT=/workspace/LightX2V/configs/ltx25/gfx1201
readonly CONTAINER_RUN_ROOT=/workspace/LightX2VRun
readonly FP8_RUN_SCRIPT_DIR=${CONTAINER_RUN_ROOT}/scripts
readonly T5_FP8_FILENAME=models_t5_umt5-xxl-enc-fp8.pth

usage() {
    cat <<'EOF'
Usage:
  ./lightx2vModelrun                         Open an interactive Wan2.2 container shell
  ./lightx2vModelrun --run-wan21-gfx1201    Run the consolidated Wan2.1 container entry
  ./lightx2vModelrun --run-wan22-gfx1201    Run the consolidated Wan2.2 lazy/B1 entry
  ./lightx2vModelrun --run-minimax-h3-gfx1201
                                            Run MiniMax-H3 FL2V on 1 GPU, Ulysses SP2/SP4/SP8, or Ring SP16
                                            (H3 launcher only; TP stays disabled)
  ./lightx2vModelrun --run-ltx23-gfx1201   Run LTX-2.3 Distilled FP8 B0 on exactly 2 GPUs
  ./lightx2vModelrun --run-ltx25-contract-collector
                                            Collect LTX-2.5 B0-reference contracts on 2 GPUs
  ./lightx2vModelrun --run-ltx25-c1-gfx1201
                                            Run LTX-2.5 C1 on exactly 2 GPUs
  ./lightx2vModelrun COMMAND [ARG...]        Run a command in the container

Ordinary timing runs should use the seven numbered scripts:
  scripts/run_01_wan21_720p_81f_16fps_1gpu.sh
  scripts/run_02_wan21_720p_81f_16fps_scale.sh
  scripts/run_04_wan22_480p_81f_16fps_scale.sh
  scripts/run_05_wan22_480p_121f_24fps_scale.sh
  scripts/run_06_wan22_720p_81f_16fps_scale.sh
  scripts/run_07_wan22_720p_121f_24fps_scale.sh
  scripts/run_08_minimax_h3_768p_124f_24fps_scale.sh --image IMAGE

Important overrides:
  GPU_DEVICES, IMAGE, MODEL_STORE, OUTPUT_DIR, INPUT_DIR, CACHE_DIR
  H3_MODEL_DIR, H3_TURBO_DIR
  LTX23_CHECKPOINT, LTX23_UPSCALER, LTX23_GEMMA_DIR
  LTX25_MODEL_ROOT
  TARGET_HEIGHT, TARGET_WIDTH, TARGET_VIDEO_LENGTH, TARGET_FPS
  LIGHTX2V_WAN_BLOCK_OFFLOAD_SCHEDULE=auto|baseline|b1
  DRY_RUN=1, SKIP_MODEL_CHECKS=1

Legacy profile, runtune, LoRA, and Experiment-A/B launchers are retired under
scripts/deprecated/ and are not part of the active production interface.
EOF
    return
    cat <<'EOF'
Usage:
  ./lightx2vModelrun                 Open an interactive shell
  ./lightx2vModelrun --infer-fp8     Run prebuilt GFX1201 FP8 4-step I2V on 1/2/4/8/16 GPUs
  ./lightx2vModelrun --infer-sage-fp8
                                      Use native gfx1201 SageAttention2; SP16 uses Ring LSE merge
  ./lightx2vModelrun --infer-lora-fp8
                                      Merge LoRAs, quantize to FP8, then infer on 1/2/4/8/16 GPUs
  ./lightx2vModelrun --infer-bf16    Run the GFX1201 BF16 4-step I2V example
  GPU_DEVICES=0,1 ./lightx2vModelrun --run-wan21-gfx1201
                                      Run the consolidated Wan2.1 timing entry
  GPU_DEVICES=0,1 ./lightx2vModelrun --run-wan22-gfx1201
                                      Run the consolidated Wan2.2 lazy/B1 timing entry
  GPU_DEVICES=0,1 ./lightx2vModelrun --infer-wan21-sage-fp8
                                      Run Wan2.1 720p/81-frame FP8 with Sage on Ulysses SP=2
  GPU_DEVICES=0,1,2,3 ./lightx2vModelrun --wan21-ckconv3d-v1-release
                                      Run Wan2.1 with resident untiled CK-v1 VAE on 1/2/4/8/16 GPUs
  ./scripts/run_wan21_ckconv3d_v1_scale_sweep.sh
                                      Run full CK-v1 production inference at all five scales sequentially
  GPU_DEVICES=0,1,2,3 ./lightx2vModelrun --profile-wan21-ckconv3d-v1
                                      Profile real Wan2.1 CK-v1 VAE shapes on 1/2/4/8/16 GPUs
  GPU_DEVICES=0,1,2,3 ./lightx2vModelrun --profile-wan22-ckconv3d-v1
                                      Profile real Wan2.2 CK-v1 VAE shapes on 1/2/4/8/16 GPUs
  ./scripts/run_wan22_ckconv3d_v1_scale_sweep.sh
                                      Collect Wan2.2 CK-v1 shapes on 2/4/8/16 GPUs sequentially
  ./scripts/run_wan22_ckconv3d_v1_720p_5s_shape_sweep.sh
                                      Collect 720P/24fps/121f shapes on 2/4/8/16 GPUs
  ./scripts/run_wan22_ckconv3d_v1_720p_5s_sweep.sh --mode timing
                                      Measure the same 720P/24fps/121f workload
  GPU_DEVICES=0,1,2,3 ./lightx2vModelrun --wan22-ckconv3d-v1-release
                                      Run Wan2.2 with resident untiled CK-v1 VAE on 2/4/8/16 GPUs
  ./scripts/run_wan22_ckconv3d_v1_timing_sweep.sh
                                      Measure Wan2.2 CK-v1 stage timings on 2/4/8/16 GPUs
  ./scripts/run_wan22_ckconv3d_v1_480p_5s_timing_sweep.sh
                                      Measure 480P 16fps/81f and 24fps/121f on 2/4/8/16 GPUs
  GPU_DEVICES=0 ./lightx2vModelrun --benchmark-wan21-4090
                                      Run the Wan2.1 720p workload behind the published 4090 171s result
  GPU_DEVICES=0 ./lightx2vModelrun --benchmark-wan21-4090-sage
                                      Run the same Wan2.1 workload with native gfx1201 SageAttention2
  GPU_DEVICES=0,1 ./lightx2vModelrun --runtune-wan21
                                      Run FlyDSL on the first GPU and Sage on the second, sequentially
  GPU_DEVICES=0,1,2,3 ./lightx2vModelrun --runtune-wan21-vae
                                      Run four isolated Wan2.1 VAE T0 combinations in parallel
  GPU_DEVICES=0,1 ./lightx2vModelrun --runtune-wan21-ck-conv3d-v1
                                      Compare PyTorch-offload and prebuilt CK-v1 resident VAE
  ./lightx2vModelrun --infer         Alias for --infer-fp8
  ./lightx2vModelrun COMMAND [ARG...] Run a command in the container

Important environment overrides:
  WAN22_BASE_DIR       Wan2.2-I2V-A14B support-model directory
  WAN21_DISTILL_DIR    The 4-step repository's distill_fp8 directory
  MODEL_STORE          Parent of Encoders and Wan2.2-Distill-Models
  DISTILL_LORAS_DIR    Host directory containing the high/low Wan2.2 distill LoRAs
  LORA_FP8_OUTPUT_DIR  Writable host directory for merged FP8 checkpoints
  OUTPUT_DIR           Generated video directory
  INPUT_DIR            Custom input directory, available as /inputs
  CACHE_DIR            Persistent Aiter, Triton, Torch, and HF cache directory
  GPU_DEVICES          Physical HIP GPU ids (Wan2.1 CK/FP8: 1/2/4/8/16; default: 0,1)
  EXPECTED_SAGE_AITER_REV, EXPECTED_SAGE_LIGHTX2V_REV
                       Exact image source revisions required by Sage inference modes
  EXPECTED_CK_AITER_REV, EXPECTED_CK_LIGHTX2V_REV
                       Exact CK AOT image source revisions required by the release mode
  CK_CONV3D_TUNED_CSV  Host path to a generated Conv3d v1 tuned CSV; mounted read-only
  PROFILE_TAG          Output directory tag for CK Conv3d shape collection
  RUN_REPO_DIR          LightX2VRun checkout mounted read-only into the container
  EXPECTED_AITER_REV, EXPECTED_LIGHTX2V_REV
                       Exact image revisions required by CK Conv3d runtune
  IMAGE                Docker image (default: ccr.ccs.tencentyun.com/lightx2vrocm/lightx2v-rocm:gfx1201-R9600-FP8-260804-SageUtimateWithMM-T1)
  CONTAINER_NAME       Docker container name
  AUTO_REMOVE=0        Keep the stopped container
  SKIP_MODEL_CHECKS=1  Skip required model-file checks
  DRY_RUN=1            Print the docker command without starting it

FP8 inference overrides:
  PROMPT, NEGATIVE_PROMPT, IMAGE_PATH, SAVE_RESULT_PATH, SEED
  MASTER_ADDR, MASTER_PORT, TARGET_VIDEO_LENGTH, TARGET_HEIGHT, TARGET_WIDTH, TARGET_FPS
  INFER_STEPS, BASE_CONFIG_JSON, LIGHTX2V_EXTRA_ARGS
  CPU_OFFLOAD=1, OFFLOAD_GRANULARITY=block, OFFLOAD_RATIO=1.0
                          Wan2.1-compatible DiT block offload policy for Wan2.2
  RUNTUNE_ROPE_TYPE=triton_fused_qk_rope
                          RunTune RoPE backend; use torch_real_rope for baseline
  LIGHTX2V_GFX1201_FUSED_QK_ROPE=1
                          Enable full-sequence fused Q/K RoPE by default on gfx1201
  ROPE_CHUNK_SIZE=8192    Fallback-only chunk size; fused Q/K RoPE bypasses chunking
  LIGHTX2V_AMD_FP8_GEMM_BACKEND=scaled-mm
                          GFX1201 FP8 GEMM default; use aiter for the CK A/B baseline
  LIGHTX2V_AMD_MIOPEN=1    Enable MIOpen for ROCm VAE convolution (default: 0 until T0 passes)
  USE_TILING_VAE=0         Disable overlapping Wan VAE spatial tiles (default: 1 until T0 passes)
  VAE_CPU_OFFLOAD=0        Keep Wan VAE weights GPU resident (default: 1 until T0 passes)
  T5_CPU_OFFLOAD=0, CLIP_CPU_OFFLOAD=0
                          Keep an encoder resident; both default to CPU offload for Wan2.1
  USE_CHANNELS_LAST_3D=1  Test Conv3d channels-last weights independently (default: 0)
  LIGHTX2V_WARMUP=1       Enable upstream Wan warmup (disabled by default)
  LIGHTX2V_DIT_PROGRESS=0  Disable the DiT progress and final step-time summary

LoRA merge/quantization overrides:
  HIGH_NOISE_LORA_FILENAME, LOW_NOISE_LORA_FILENAME
  LORA_STRENGTH          LoRA strength (default: 1.0)
  LORA_CONVERT_DEVICE    Converter device (default: cpu)
  FORCE_LORA_CONVERT=1  Rebuild checkpoints even when matching outputs exist
  LORA_CONVERT_ONLY=1   Stop after merging and quantizing both checkpoints
EOF
}

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

require_dir() {
    [[ -d "$1" ]] || die "Required directory not found: $1"
}

require_file() {
    [[ -f "$1" ]] || die "Required file not found: $1"
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
fi

case "${1:-}" in
    --infer-lora-fp8 | --infer-bf16 | --runtune-wan21 | --runtune-wan21-vae | \
        --runtune-wan21-ck-conv3d-v1 | --profile-wan21-ckconv3d-v1 | \
        --profile-wan22-ckconv3d-v1)
        die "this legacy mode was retired; use one of scripts/run_01_*.sh, run_02_*.sh, or run_04_*.sh through run_08_*.sh"
        ;;
esac

inference_mode=shell
case "${1:-}" in
    --infer | --infer-fp8 | --infer-sage-fp8 | --wan22-ckconv3d-v1-release) inference_mode=wan22_unified ;;
    --infer-wan21-sage-fp8 | --wan21-ckconv3d-v1-release | --benchmark-wan21-4090 | --benchmark-wan21-4090-sage) inference_mode=wan21_unified ;;
    --run-wan21-gfx1201) inference_mode=wan21_unified ;;
    --run-wan22-gfx1201) inference_mode=wan22_unified ;;
    --run-minimax-h3-gfx1201) inference_mode=minimax_h3 ;;
    --run-ltx23-gfx1201) inference_mode=ltx23 ;;
    --run-ltx25-contract-collector) inference_mode=ltx25_contract ;;
    --run-ltx25-c1-gfx1201) inference_mode=ltx25_c1 ;;
esac

if [[ ! "${GPU_DEVICES}" =~ ^[0-9]+(,[0-9]+)*$ ]]; then
    die "GPU_DEVICES must be comma-separated physical HIP GPU ids, for example 0,1"
fi
IFS=',' read -r -a gpu_devices <<<"${GPU_DEVICES}"
declare -A seen_gpu_devices=()
for gpu_device in "${gpu_devices[@]}"; do
    [[ -z "${seen_gpu_devices[${gpu_device}]:-}" ]] || die "GPU_DEVICES contains duplicate id ${gpu_device}"
    seen_gpu_devices["${gpu_device}"]=1
done
gpu_count="${#gpu_devices[@]}"
fp8_run_script=
if [[ "${inference_mode}" == "wan21_unified" ]]; then
    case "${gpu_count}" in
        1 | 2 | 4 | 8 | 16) ;;
        *) die "Wan2.1 timing supports exactly 1, 2, 4, 8, or 16 GPU_DEVICES" ;;
    esac
    fp8_run_script="${FP8_RUN_SCRIPT_DIR}/lib/run_wan21_in_container.sh"
fi
if [[ "${inference_mode}" == "wan22_unified" ]]; then
    case "${gpu_count}" in
        2 | 4 | 8 | 16) ;;
        *) die "Wan2.2 timing supports exactly 2, 4, 8, or 16 GPU_DEVICES" ;;
    esac
    fp8_run_script="${FP8_RUN_SCRIPT_DIR}/lib/run_wan22_in_container.sh"
fi
if [[ "${inference_mode}" == "minimax_h3" ]]; then
    case "${gpu_count}" in
        1 | 2 | 4 | 8 | 16) ;;
        *) die "MiniMax-H3 gfx1201 supports exactly 1/2/4/8/16 GPU_DEVICES; SP2/SP4/SP8 use Ulysses and SP16 uses Ring" ;;
    esac
    [[ "${LIGHTX2V_H3_EXPLICIT_IMAGE:-0}" == "1" ]] || \
        die "MiniMax-H3 requires scripts/run_minimax_h3_fl2av_4step_768p.sh --image IMAGE; the Wan default image is not an H3 source tree"
    h3_run_script="${FP8_RUN_SCRIPT_DIR}/lib/run_minimax_h3_in_container.sh"
fi
if [[ "${inference_mode}" == "ltx23" ]]; then
    [[ "${gpu_count}" == 2 ]] || die "LTX-2.3 FP8 B0 requires exactly two GPU_DEVICES"
    [[ "${LIGHTX2V_LTX23_EXPLICIT_IMAGE:-0}" == 1 ]] || \
        die "LTX-2.3 requires scripts/run_ltx23_fp8_b0_704x1280_5s.sh --image IMAGE"
    ltx23_run_script="${FP8_RUN_SCRIPT_DIR}/lib/run_ltx23_in_container.sh"
fi
if [[ "${inference_mode}" == "ltx25_contract" ]]; then
    [[ "${gpu_count}" == 2 ]] || die "LTX-2.5 contract collection requires exactly two GPU_DEVICES"
    [[ "${LIGHTX2V_LTX25_EXPLICIT_COLLECTOR:-0}" == 1 ]] || \
        die "LTX-2.5 contract mode requires scripts/collector/run_ltx25_contract_collector.sh"
    ltx25_run_script="${FP8_RUN_SCRIPT_DIR}/lib/run_ltx25_in_container.sh"
fi
if [[ "${inference_mode}" == "ltx25_c1" ]]; then
    [[ "${gpu_count}" == 2 ]] || die "LTX-2.5 C1 requires exactly two GPU_DEVICES"
    [[ "${LIGHTX2V_LTX25_C1_EXPLICIT:-0}" == 1 ]] || \
        die "LTX-2.5 C1 requires scripts/run_ltx25_c1_704x1280_5s.sh"
    ltx25_c1_run_script="${FP8_RUN_SCRIPT_DIR}/lib/run_ltx25_c1_in_container.sh"
fi

is_wan21_mode=0
is_minimax_h3_mode=0
is_ltx23_mode=0
is_ltx25_mode=0
is_ltx25_c1_mode=0
uses_fp8_run_script=0
if [[ "${inference_mode}" == wan21_unified ]]; then
    is_wan21_mode=1
fi
if [[ "${inference_mode}" == minimax_h3 ]]; then
    is_minimax_h3_mode=1
fi
if [[ "${inference_mode}" == ltx23 ]]; then
    is_ltx23_mode=1
fi
if [[ "${inference_mode}" == ltx25_contract ]]; then
    is_ltx25_mode=1
fi
if [[ "${inference_mode}" == ltx25_c1 ]]; then
    is_ltx25_mode=1
    is_ltx25_c1_mode=1
fi
if [[ "${inference_mode}" == wan21_unified || "${inference_mode}" == wan22_unified ]]; then
    uses_fp8_run_script=1
fi
h3_frame_source=
h3_first_frame_path=
h3_last_frame_path=
if [[ "${is_minimax_h3_mode}" == 1 ]]; then
    [[ -n "${H3_MODEL_DIR:-}" ]] || die "H3_MODEL_DIR is required for MiniMax-H3"
    [[ -n "${H3_TURBO_DIR:-}" ]] || die "H3_TURBO_DIR is required for MiniMax-H3"
    h3_frame_source="${H3_FRAME_SOURCE:-image}"
    case "${h3_frame_source}" in
        image)
            h3_first_frame_path="${CONTAINER_H3_IMAGE_FIRST_FRAME}"
            h3_last_frame_path="${CONTAINER_H3_IMAGE_LAST_FRAME}"
            ;;
        host)
            [[ -n "${H3_FIRST_FRAME:-}" ]] || die "H3_FIRST_FRAME is required when H3_FRAME_SOURCE=host"
            [[ -n "${H3_LAST_FRAME:-}" ]] || die "H3_LAST_FRAME is required when H3_FRAME_SOURCE=host"
            h3_first_frame_path="${CONTAINER_H3_FIRST_FRAME}"
            h3_last_frame_path="${CONTAINER_H3_LAST_FRAME}"
            ;;
        *) die "H3_FRAME_SOURCE must be image or host" ;;
    esac
    readonly h3_source_mode=image
fi
if [[ "${is_ltx23_mode}" == 1 ]]; then
    [[ "${LTX23_CHECKPOINT}" == /* ]] || die "LTX23_CHECKPOINT must be an absolute host path"
    [[ "${LTX23_UPSCALER}" == /* ]] || die "LTX23_UPSCALER must be an absolute host path"
    [[ "${LTX23_GEMMA_DIR}" == /* ]] || die "LTX23_GEMMA_DIR must be an absolute host path"
fi
if [[ "${is_ltx25_mode}" == 1 ]]; then
    [[ "${LTX25_MODEL_ROOT}" == /* ]] || die "LTX25_MODEL_ROOT must be an absolute host path"
    # Preserve the host absolute model path in the mount namespace.
    container_ltx25_root="${LTX25_MODEL_ROOT}"
    if [[ -n "${LTX25_LIGHTX2V_SOURCE:-}" ]]; then
        [[ "${LTX25_LIGHTX2V_SOURCE}" == /* ]] || die "LTX25_LIGHTX2V_SOURCE must be an absolute host path"
        if [[ "${DRY_RUN:-0}" == 1 ]]; then
            ltx25_lightx2v_source="$(realpath -m "${LTX25_LIGHTX2V_SOURCE}")"
        else
            require_dir "${LTX25_LIGHTX2V_SOURCE}/lightx2v"
            ltx25_lightx2v_source="$(realpath "${LTX25_LIGHTX2V_SOURCE}")"
        fi
    fi
    if [[ "${is_ltx25_c1_mode}" == 1 ]]; then
        ltx25_tunableop_cache=""
        if [[ -n "${LTX25_TUNABLEOP_CACHE:-}" ]]; then
            [[ "${LTX25_TUNABLEOP_CACHE}" == /* ]] || die "LTX25_TUNABLEOP_CACHE must be an absolute host path"
            if [[ "${DRY_RUN:-0}" == 1 ]]; then
                ltx25_tunableop_cache="$(realpath -m "${LTX25_TUNABLEOP_CACHE}")"
            else
                require_file "${LTX25_TUNABLEOP_CACHE}"
                ltx25_tunableop_cache="$(realpath "${LTX25_TUNABLEOP_CACHE}")"
            fi
        fi
    fi
fi

require_dir "${RUN_REPO_DIR}"
if [[ "${uses_fp8_run_script}" == 1 ]]; then
    require_file "${RUN_REPO_DIR}/${fp8_run_script#${CONTAINER_RUN_ROOT}/}"
    require_file "${RUN_REPO_DIR}/scripts/report_dit_progress.py"
fi
if [[ "${is_minimax_h3_mode}" == 1 ]]; then
    require_file "${RUN_REPO_DIR}/${h3_run_script#${CONTAINER_RUN_ROOT}/}"
    require_file "${RUN_REPO_DIR}/scripts/lib/build_minimax_h3_runtime_config.py"
    require_file "${RUN_REPO_DIR}/scripts/lib/preflight_minimax_h3_gfx1201.py"
fi
if [[ "${is_ltx23_mode}" == 1 ]]; then
    require_file "${RUN_REPO_DIR}/${ltx23_run_script#${CONTAINER_RUN_ROOT}/}"
    require_file "${RUN_REPO_DIR}/scripts/lib/preflight_ltx23_fp8_gfx1201.py"
    require_file "${RUN_REPO_DIR}/scripts/lib/check_ltx23_phase_handoff.py"
    require_file "${RUN_REPO_DIR}/scripts/collector/collect_ltx23_weight_probe.py"
fi
if [[ "${is_ltx25_mode}" == 1 ]]; then
    if [[ "${is_ltx25_c1_mode}" == 1 ]]; then
        require_file "${RUN_REPO_DIR}/${ltx25_c1_run_script#${CONTAINER_RUN_ROOT}/}"
        require_file "${RUN_REPO_DIR}/scripts/lib/build_ltx25_c1_runtime_config.py"
        require_file "${RUN_REPO_DIR}/scripts/lib/build_ltx25_runtime_config.py"
    else
        require_file "${RUN_REPO_DIR}/${ltx25_run_script#${CONTAINER_RUN_ROOT}/}"
        require_file "${RUN_REPO_DIR}/scripts/lib/build_ltx25_runtime_config.py"
        require_file "${RUN_REPO_DIR}/scripts/collector/validate_ltx25_contract_bundle.py"
    fi
fi
encoder_mount_source="${ENCODERS_DIR}"
encoder_mount_target="${CONTAINER_MODELS_ROOT}/encoders/t5"
t5_fp8_path="${ENCODERS_DIR}/${T5_FP8_FILENAME}"
if [[ -f "${ENCODERS_DIR}/t5/${T5_FP8_FILENAME}" ]]; then
    encoder_mount_target="${CONTAINER_MODELS_ROOT}/encoders"
    t5_fp8_path="${ENCODERS_DIR}/t5/${T5_FP8_FILENAME}"
fi

resolved_image_id=
if [[ "${DRY_RUN:-0}" != "1" ]]; then
    command -v docker >/dev/null 2>&1 || die "docker is not installed or is not in PATH"
    [[ -c /dev/kfd ]] || die "ROCm device /dev/kfd is unavailable"
    [[ -d /dev/dri ]] || die "DRM device directory /dev/dri is unavailable"

    if [[ "${is_ltx25_mode}" == 1 ]]; then
        require_dir "${LTX25_MODEL_ROOT}"
    elif [[ "${is_ltx23_mode}" == 1 ]]; then
        require_file "${LTX23_CHECKPOINT}"
        require_file "${LTX23_UPSCALER}"
        require_dir "${LTX23_GEMMA_DIR}"
    elif [[ "${is_minimax_h3_mode}" == 1 ]]; then
        require_dir "${H3_MODEL_DIR:?H3_MODEL_DIR is required}"
        require_dir "${H3_TURBO_DIR:?H3_TURBO_DIR is required}"
        if [[ "${h3_frame_source}" == host ]]; then
            require_file "${H3_FIRST_FRAME:?H3_FIRST_FRAME is required}"
            require_file "${H3_LAST_FRAME:?H3_LAST_FRAME is required}"
        fi
    elif [[ "${is_wan21_mode}" == 1 ]]; then
        require_dir "${WAN21_DISTILL_DIR}"
    else
        require_dir "${ENCODERS_DIR}"
        require_dir "${DISTILL_MODELS_DIR}"
        require_dir "${WAN22_BASE_DIR}"
    fi
    if [[ "${SKIP_MODEL_CHECKS:-0}" != "1" ]]; then
        if [[ "${is_ltx25_mode}" == 1 ]]; then
            : # The in-container entry resolves the explicit split asset paths.
        elif [[ "${is_ltx23_mode}" == 1 ]]; then
            : # Strict LTX checkpoint/Gemma contents are validated by preflight.
        elif [[ "${is_minimax_h3_mode}" == 1 ]]; then
            require_file "${H3_TURBO_DIR}/minimax_h3_fl2v_turbo_4step_v1.0_768p_bf16.safetensors"
        elif [[ "${is_wan21_mode}" == 1 ]]; then
            require_dir "${WAN21_DISTILL_DIR}/google/umt5-xxl"
            require_file "${WAN21_DISTILL_DIR}/google/umt5-xxl/special_tokens_map.json"
            require_file "${WAN21_DISTILL_DIR}/google/umt5-xxl/spiece.model"
            require_file "${WAN21_DISTILL_DIR}/google/umt5-xxl/tokenizer_config.json"
            require_file "${WAN21_DISTILL_DIR}/google/umt5-xxl/tokenizer.json"
            require_file "${WAN21_DISTILL_DIR}/Wan2.1_VAE.pth"
            require_file "${WAN21_DISTILL_DIR}/config.json"
            require_file "${WAN21_DISTILL_DIR}/diffusion_pytorch_model.safetensors.index.json"
            require_file "${WAN21_DISTILL_DIR}/non_block.safetensors"
            require_file "${WAN21_DISTILL_DIR}/models_t5_umt5-xxl-enc-fp8.pth"
            require_file "${WAN21_DISTILL_DIR}/clip-fp8.pth"
            for block_index in {0..39}; do
                require_file "${WAN21_DISTILL_DIR}/block_${block_index}.safetensors"
            done
        elif [[ "${is_wan21_mode}" != 1 ]]; then
            require_dir "${WAN22_BASE_DIR}/google/umt5-xxl"
            require_file "${WAN22_BASE_DIR}/google/umt5-xxl/special_tokens_map.json"
            require_file "${WAN22_BASE_DIR}/google/umt5-xxl/spiece.model"
            require_file "${WAN22_BASE_DIR}/google/umt5-xxl/tokenizer_config.json"
            require_file "${WAN22_BASE_DIR}/google/umt5-xxl/tokenizer.json"
            require_file "${WAN22_BASE_DIR}/high_noise_model/config.json"
            require_file "${WAN22_BASE_DIR}/low_noise_model/config.json"
            require_file "${WAN22_BASE_DIR}/Wan2.1_VAE.pth"
        fi
        if [[ "${inference_mode}" == "wan22_unified" ]]; then
            require_file "${t5_fp8_path}"
            require_file "${DISTILL_MODELS_DIR}/wan2.2_i2v_A14b_high_noise_scaled_fp8_e4m3_lightx2v_4step.safetensors"
            require_file "${DISTILL_MODELS_DIR}/wan2.2_i2v_A14b_low_noise_scaled_fp8_e4m3_lightx2v_4step.safetensors"
        fi
    fi

    mkdir -p \
        "${INPUT_DIR}" \
        "${OUTPUT_DIR}" \
        "${CACHE_DIR}/aiter" \
        "${CACHE_DIR}/huggingface" \
        "${CACHE_DIR}/torch_extensions" \
        "${CACHE_DIR}/triton"
    resolved_image_id="$(docker image inspect --format '{{.Id}}' "${IMAGE}" 2>/dev/null)" || \
        die "Docker image is unavailable: ${IMAGE}"
fi

container_model_path="${CONTAINER_BASE_MODEL}"
if [[ "${is_ltx25_mode}" == 1 ]]; then
    container_model_path="${container_ltx25_root}"
elif [[ "${is_ltx23_mode}" == 1 ]]; then
    container_model_path="${CONTAINER_LTX23_ROOT}"
elif [[ "${is_minimax_h3_mode}" == 1 ]]; then
    container_model_path="${CONTAINER_H3_MODEL}"
elif [[ "${is_wan21_mode}" == 1 ]]; then
    container_model_path="${CONTAINER_WAN21_DISTILL_MODEL}"
fi

docker_args=(
    run
    --name "${CONTAINER_NAME}"
    --hostname "${CONTAINER_NAME}"
    --add-host "${CONTAINER_NAME}:127.0.0.1"
    --init
    --network=host
    --ipc=host
    --cap-add=SYS_PTRACE
    --security-opt=seccomp=unconfined
    --device=/dev/kfd
    --device=/dev/dri
    --ulimit=memlock=-1:-1
    --ulimit=stack=67108864:67108864
    --workdir=/workspace/LightX2V
    --env "HIP_VISIBLE_DEVICES=${GPU_DEVICES}"
    --env PLATFORM=amd_rocm
    --env DTYPE=BF16
    --env TOKENIZERS_PARALLELISM=false
    --env "MODELS_ROOT=${CONTAINER_MODELS_ROOT}"
    --env "MODEL_PATH=${container_model_path}"
    --env LIGHTX2V_PATH=/workspace/LightX2V
    --env AITER_JIT_DIR=/workspace/.cache/aiter
    --env TRITON_CACHE_DIR=/workspace/.cache/triton
    --env TORCH_EXTENSIONS_DIR=/workspace/.cache/torch_extensions
    --env HF_HOME=/root/.cache/huggingface
    --env PYTORCH_ROCM_ARCH=gfx1201
    --env AITER_ROCM_ARCH=gfx1201
    --env GPU_ARCHS=gfx1201
    --env CU_NUM=24
    --env AITER_LOG_TUNED_CONFIG=1
    --env HSA_ENABLE_IPC_MODE_LEGACY=1
    --env HIP_FORCE_DEV_KERNARG=1
    --env SAFETENSORS_FAST_GPU=1
    --mount "type=bind,source=${RUN_REPO_DIR},target=${CONTAINER_RUN_ROOT},readonly"
    --mount "type=bind,source=${INPUT_DIR},target=/inputs"
    --mount "type=bind,source=${OUTPUT_DIR},target=/workspace/LightX2V/save_results"
    --mount "type=bind,source=${CACHE_DIR}/aiter,target=/workspace/.cache/aiter"
    --mount "type=bind,source=${CACHE_DIR}/huggingface,target=/root/.cache/huggingface"
    --mount "type=bind,source=${CACHE_DIR}/torch_extensions,target=/workspace/.cache/torch_extensions"
    --mount "type=bind,source=${CACHE_DIR}/triton,target=/workspace/.cache/triton"
)

if [[ -n "${CK_CONV3D_TUNED_CSV:-}" ]]; then
    if [[ "${DRY_RUN:-0}" == 1 ]]; then
        ck_conv3d_tuned_csv="$(realpath -m "${CK_CONV3D_TUNED_CSV}")"
    else
        require_file "${CK_CONV3D_TUNED_CSV}"
        ck_conv3d_tuned_csv="$(realpath "${CK_CONV3D_TUNED_CSV}")"
    fi
    docker_args+=(
        --mount "type=bind,source=${ck_conv3d_tuned_csv},target=/workspace/ck-conv3d-config/conv3d_v1_tuned.csv,readonly"
        --env AITER_CONFIG_CONV3D_V1=/workspace/ck-conv3d-config/conv3d_v1_tuned.csv
    )
fi

if [[ "${is_ltx25_mode}" == 1 ]]; then
    docker_args+=(
        --mount "type=bind,source=${LTX25_MODEL_ROOT},target=${container_ltx25_root},readonly"
        --env "LTX25_MODEL_ROOT=${container_ltx25_root}"
        --env LTX25_WORLD_SIZE=2
    )
    if [[ "${is_ltx25_c1_mode}" == 1 ]]; then
        ltx25_tunableop_cache_pattern="${CONTAINER_LTX25_TUNABLEOP_ROOT}/tunableop_results_full%d.csv"
        ltx25_tunableop_cache_rank0="${CONTAINER_LTX25_TUNABLEOP_ROOT}/tunableop_results_full0.csv"
        ltx25_tunableop_cache_rank1="${CONTAINER_LTX25_TUNABLEOP_ROOT}/tunableop_results_full1.csv"
        if [[ -n "${ltx25_tunableop_cache}" ]]; then
            ltx25_tunableop_cache_pattern=/workspace/ltx25-c1/tunableop_results_full%d.csv
            ltx25_tunableop_cache_rank0=/workspace/ltx25-c1/tunableop_results_full0.csv
            ltx25_tunableop_cache_rank1=/workspace/ltx25-c1/tunableop_results_full1.csv
            docker_args+=(
                --mount "type=bind,source=${ltx25_tunableop_cache},target=${ltx25_tunableop_cache_rank0},readonly"
                --mount "type=bind,source=${ltx25_tunableop_cache},target=${ltx25_tunableop_cache_rank1},readonly"
            )
        fi
        docker_args+=(
            --env LIGHTX2V_LTX25_C1_IN_CONTAINER=1
            --env LTX25_C1_RESULT_DIR=/workspace/LightX2V/save_results
            --env PYTORCH_TUNABLEOP_ENABLED=1
            --env PYTORCH_TUNABLEOP_TUNING=0
            --env PYTORCH_TUNABLEOP_RECORD_UNTUNED=0
            --env "PYTORCH_TUNABLEOP_FILENAME=${ltx25_tunableop_cache_pattern}"
            --env "LTX25_TUNABLEOP_CACHE_RANK0=${ltx25_tunableop_cache_rank0}"
            --env "LTX25_TUNABLEOP_CACHE_RANK1=${ltx25_tunableop_cache_rank1}"
            --env LIGHTX2V_AMD_RMSNORM_BACKEND=ck
            --env LIGHTX2V_VAE_CONV3D_BACKEND=Aiter_CK_Conv3d_v1
            --env LIGHTX2V_CK_CONV3D_PROFILE_DIR=/workspace/LightX2V/save_results/ck_conv3d_routes
        )
    else
        docker_args+=(
            --env LIGHTX2V_LTX25_IN_CONTAINER=1
            --env LTX25_EVIDENCE_DIR=/workspace/LightX2V/save_results
            --env PYTORCH_TUNABLEOP_ENABLED=0
        )
    fi
    if [[ -n "${ltx25_lightx2v_source:-}" ]]; then
        docker_args+=(
            --mount "type=bind,source=${ltx25_lightx2v_source},target=/workspace/LightX2V,readonly"
        )
    fi
elif [[ "${is_ltx23_mode}" == 1 ]]; then
    docker_args+=(
        --mount "type=bind,source=${LTX23_CHECKPOINT},target=${CONTAINER_LTX23_CHECKPOINT},readonly"
        --mount "type=bind,source=${LTX23_UPSCALER},target=${CONTAINER_LTX23_UPSCALER},readonly"
        --mount "type=bind,source=${LTX23_GEMMA_DIR},target=${CONTAINER_LTX23_GEMMA},readonly"
        --env "LTX23_CHECKPOINT_CONTAINER=${CONTAINER_LTX23_CHECKPOINT}"
        --env "LTX23_UPSCALER_CONTAINER=${CONTAINER_LTX23_UPSCALER}"
        --env "LTX23_GEMMA_CONTAINER=${CONTAINER_LTX23_GEMMA}"
        --env PYTORCH_TUNABLEOP_ENABLED=0
    )
elif [[ "${is_minimax_h3_mode}" == 1 ]]; then
    docker_args+=(
        --mount "type=bind,source=${H3_MODEL_DIR},target=${CONTAINER_H3_MODEL},readonly"
        --mount "type=bind,source=${H3_TURBO_DIR},target=${CONTAINER_H3_TURBO},readonly"
        --env "H3_SOURCE_MODE=${h3_source_mode}"
        --env "H3_FRAME_SOURCE=${h3_frame_source}"
        --env "IMAGE_PATH=${h3_first_frame_path}"
        --env "LAST_FRAME_PATH=${h3_last_frame_path}"
        --env PYTORCH_TUNABLEOP_ENABLED=0
    )
    if [[ "${h3_frame_source}" == host ]]; then
        docker_args+=(
            --mount "type=bind,source=${H3_FIRST_FRAME},target=${CONTAINER_H3_FIRST_FRAME},readonly"
            --mount "type=bind,source=${H3_LAST_FRAME},target=${CONTAINER_H3_LAST_FRAME},readonly"
        )
    fi
elif [[ "${is_wan21_mode}" == 1 ]]; then
    docker_args+=(
        --mount "type=bind,source=${MODEL_STORE},target=/data,readonly"
        --mount "type=bind,source=${WAN21_DISTILL_DIR},target=${CONTAINER_WAN21_DISTILL_MODEL},readonly"
    )
else
    docker_args+=(
        --mount "type=bind,source=${MODEL_STORE},target=/data,readonly"
        --mount "type=bind,source=${WAN22_BASE_DIR},target=${CONTAINER_BASE_MODEL},readonly"
        --mount "type=bind,source=${encoder_mount_source},target=${encoder_mount_target},readonly"
        --mount "type=bind,source=${DISTILL_MODELS_DIR},target=${CONTAINER_MODELS_ROOT}/lightx2v/Wan2.2-Distill-Models,readonly"
    )
fi

if [[ "${AUTO_REMOVE:-1}" == "1" ]]; then
    docker_args+=(--rm)
fi

if [[ -t 0 && -t 1 ]]; then
    docker_args+=(-it)
else
    docker_args+=(-i)
fi

for host_group in video render; do
    if group_entry="$(getent group "${host_group}" 2>/dev/null)"; then
        docker_args+=(--group-add "$(cut -d: -f3 <<<"${group_entry}")")
    fi
done

for passthrough_env in HF_TOKEN HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy; do
    if [[ -n "${!passthrough_env:-}" ]]; then
        docker_args+=(--env "${passthrough_env}")
    fi
done

for inference_env in \
    PROMPT NEGATIVE_PROMPT IMAGE_PATH SAVE_RESULT_PATH SEED \
    MASTER_ADDR MASTER_PORT TARGET_VIDEO_LENGTH TARGET_HEIGHT TARGET_WIDTH TARGET_FPS \
    INFER_STEPS BASE_CONFIG_JSON LIGHTX2V_EXTRA_ARGS CONFIG_ONLY \
    CPU_OFFLOAD OFFLOAD_GRANULARITY OFFLOAD_RATIO \
    ROPE_TYPE LIGHTX2V_GFX1201_FUSED_QK_ROPE LIGHTX2V_AMD_FP8_GEMM_BACKEND \
    LIGHTX2V_AMD_MIOPEN LIGHTX2V_VAE_CONV3D_BACKEND PROFILE_WORKLOAD \
    SEQ_P_ATTN_TYPE SELF_ATTN_TYPE \
    USE_TILING_VAE VAE_CPU_OFFLOAD T5_CPU_OFFLOAD \
    CLIP_CPU_OFFLOAD USE_CHANNELS_LAST_3D \
    LIGHTX2V_WARMUP LIGHTX2V_DIT_PROGRESS ROPE_CHUNK_SIZE \
    LIGHTX2V_WAN_BLOCK_OFFLOAD_SCHEDULE LAST_FRAME_PATH H3_SMOKE H3_PREFLIGHT_ONLY \
    H3_EVIDENCE_DIR H3_PROMPT_PRESET H3_PROMPT_FILE H3_MEGADISCOVERY \
    H3_MEGADISCOVERY_TIMEOUT_SECONDS \
    NCCL_DEBUG NCCL_DEBUG_SUBSYS NCCL_DEBUG_FILE \
    LIGHTX2V_H3_RUN_COLLECTOR LIGHTX2V_H3_RUN_COLLECTOR_OUTPUT \
    LTX23_PREFLIGHT_ONLY LTX23_COLLECT LTX23_EVIDENCE_DIR \
    LTX23_QUICK_GEMM_PROBE LTX23_EXPECTED_ROCM_PREFIX \
    LTX23_WEIGHT_PROBE_ONLY LTX23_WEIGHT_PROBE_SHA256 \
    LTX23_HANDOFF_VRAM_LIMIT_MIB LTX23_HANDOFF_TIMEOUT_SECONDS \
    LIGHTX2V_LTX25_CONTRACT_RUN_ID LIGHTX2V_LTX25_CONTRACT_ULTRA LTX25_REQUIRE_UPSAMPLE \
    LIGHTX2V_SOURCE_REVISION AITER_SOURCE_REVISION AITER_COMMIT; do
    # H3 resolves these paths from H3_FRAME_SOURCE and mounts the selected host
    # files above. Re-appending inherited values here would create duplicate
    # Docker environment entries whose final (stale) value wins.
    if [[ "${is_minimax_h3_mode}" == 1 && ( "${inference_env}" == IMAGE_PATH || "${inference_env}" == LAST_FRAME_PATH ) ]]; then
        continue
    fi
    # LTX-2.3 B0 is a frozen workload. Do not let stale Wan/H3 overrides from
    # the host leak into the container and create a second effective profile.
    if [[ "${is_ltx23_mode}" == 1 ]]; then
        case "${inference_env}" in
            TARGET_VIDEO_LENGTH | TARGET_HEIGHT | TARGET_WIDTH | TARGET_FPS | INFER_STEPS | BASE_CONFIG_JSON)
                continue
                ;;
        esac
    fi
    if [[ -n "${!inference_env:-}" ]]; then
        docker_args+=(--env "${inference_env}=${!inference_env}")
    fi
done

if [[ -e /etc/localtime ]]; then
    docker_args+=(--mount type=bind,source=/etc/localtime,target=/etc/localtime,readonly)
fi

container_command=(/bin/bash)
if [[ "${is_ltx25_mode}" == 1 ]]; then
    if [[ "${is_ltx25_c1_mode}" == 1 ]]; then
        container_command=(/bin/bash "${ltx25_c1_run_script}")
    else
        container_command=(/bin/bash "${ltx25_run_script}")
    fi
elif [[ "${is_ltx23_mode}" == 1 ]]; then
    container_command=(/bin/bash "${ltx23_run_script}")
elif [[ "${uses_fp8_run_script}" == 1 ]]; then
    container_command=(/bin/bash "${fp8_run_script}")
elif [[ "${is_minimax_h3_mode}" == 1 ]]; then
    container_command=(/bin/bash "${h3_run_script}")
elif (( $# > 0 )); then
    container_command=("$@")
fi

printf 'Image:          %s\n' "${IMAGE}"
if [[ -n "${resolved_image_id}" ]]; then
    printf 'Image ID:       %s\n' "${resolved_image_id}"
fi
printf 'Container:      %s\n' "${CONTAINER_NAME}"
printf 'GPU devices:    %s\n' "${GPU_DEVICES}"
printf 'Mode:           %s\n' "${inference_mode}"
if [[ "${is_ltx25_mode}" == 1 ]]; then
    printf 'LTX-2.5 model:  %s -> %s\n' "${LTX25_MODEL_ROOT}" "${container_ltx25_root}"
    if [[ -n "${ltx25_lightx2v_source:-}" ]]; then
        printf 'LTX-2.5 source: %s -> /workspace/LightX2V (host checkout)\n' "${ltx25_lightx2v_source}"
    else
        printf 'LTX-2.5 source: /workspace/LightX2V (from image)\n'
    fi
    if [[ "${is_ltx25_c1_mode}" == 1 ]]; then
        printf 'LTX-2.5 route:  C1; TunableOp replay + role attention/QK RMS + strict RoPE + CK Conv3D\n'
        if [[ -n "${ltx25_tunableop_cache}" ]]; then
            printf 'LTX-2.5 GEMM:   %s -> rank-local cache paths (host override, read-only)\n' "${ltx25_tunableop_cache}"
        else
            printf 'LTX-2.5 GEMM:   %s (image cache, read-only)\n' "${ltx25_tunableop_cache_pattern}"
        fi
        printf 'LTX-2.5 Conv3D: exact tuned hit required; rank route report enabled\n'
    elif [[ "${LIGHTX2V_LTX25_CONTRACT_ULTRA:-0}" == 1 ]]; then
        printf 'LTX-2.5 route:  CollectorUltra evidence; C1 probe disabled\n'
    else
        printf 'LTX-2.5 route:  B0-reference contract collection; C1 probe disabled\n'
    fi
elif [[ "${is_ltx23_mode}" == 1 ]]; then
    printf 'LTX checkpoint:  %s -> %s\n' "${LTX23_CHECKPOINT}" "${CONTAINER_LTX23_CHECKPOINT}"
    printf 'LTX upscaler:   %s -> %s\n' "${LTX23_UPSCALER}" "${CONTAINER_LTX23_UPSCALER}"
    printf 'LTX Gemma:      %s -> %s\n' "${LTX23_GEMMA_DIR}" "${CONTAINER_LTX23_GEMMA}"
    printf 'LTX LightX2V:   /workspace/LightX2V (from image)\n'
    printf 'LTX workload:   704x1280 final, 352x640 Stage 1, 121f@24fps, SP2, 8+3 steps\n'
    printf 'LTX L2 route:   torch._scaled_mm + Torch SDPA/norm/RoPE/modulate\n'
elif [[ "${is_minimax_h3_mode}" == 1 ]]; then
    printf 'H3 model:       %s -> %s\n' "${H3_MODEL_DIR}" "${CONTAINER_H3_MODEL}"
    printf 'H3 source mode: %s\n' "${h3_source_mode}"
    printf 'H3 LightX2V:    /workspace/LightX2V (from image)\n'
    printf 'H3 turbo:       %s -> %s\n' "${H3_TURBO_DIR}" "${CONTAINER_H3_TURBO}"
    printf 'H3 frame source: %s\n' "${h3_frame_source}"
    printf 'H3 Core attn:   %s\n' "aiter_fav3_sage_bf16_attn (sage_attn_v2_gfx1201)"
    printf 'H3 Q/K RMS:     %s\n' "minimax_h3_aiter_triton_qk"
    printf 'H3 Core RoPE:   %s\n' "minimax_h3_triton_strict_rope"
    printf 'H4 Video attn:  %s\n' "aiter_triton_mha"
    printf 'H3 Dense GEMM:  %s\n' "torch.mm/default ROCm BLAS heuristic; TunableOp disabled"
    if [[ "${h3_frame_source}" == host ]]; then
        printf 'H3 first frame: %s -> %s\n' "${H3_FIRST_FRAME}" "${h3_first_frame_path}"
        printf 'H3 last frame:  %s -> %s\n' "${H3_LAST_FRAME}" "${h3_last_frame_path}"
    else
        printf 'H3 first frame: %s\n' "${h3_first_frame_path}"
        printf 'H3 last frame:  %s\n' "${h3_last_frame_path}"
    fi
elif [[ "${is_wan21_mode}" == 1 ]]; then
    printf 'Wan2.1 Distill: %s\n' "${WAN21_DISTILL_DIR}"
else
    printf 'Base model:     %s\n' "${WAN22_BASE_DIR}"
    printf 'Encoders:       %s -> %s\n' "${encoder_mount_source}" "${encoder_mount_target}"
    printf 'Distill models: %s\n' "${DISTILL_MODELS_DIR}"
fi
printf 'Inputs:         %s\n' "${INPUT_DIR}"
printf 'Outputs:        %s\n' "${OUTPUT_DIR}"
printf 'Cache:          %s\n' "${CACHE_DIR}"
if [[ -n "${CK_CONV3D_TUNED_CSV:-}" ]]; then
    printf 'Conv3d CSV:     %s\n' "${ck_conv3d_tuned_csv}"
fi
printf 'Run scripts:    %s -> %s\n' "${RUN_REPO_DIR}" "${CONTAINER_RUN_ROOT}"
if [[ "${uses_fp8_run_script}" == 1 ]]; then
    printf 'FP8 launcher:   %s\n' "${fp8_run_script}"
fi
if [[ "${is_minimax_h3_mode}" == 1 ]]; then
    printf 'H3 launcher:    %s\n' "${h3_run_script}"
fi
if [[ "${is_ltx23_mode}" == 1 ]]; then
    printf 'LTX launcher:   %s\n' "${ltx23_run_script}"
    if [[ "${LTX23_WEIGHT_PROBE_ONLY:-0}" == 1 ]]; then
        printf 'LTX action:     in-container weight probe only\n'
    fi
fi
if [[ "${is_ltx25_mode}" == 1 ]]; then
    if [[ "${is_ltx25_c1_mode}" == 1 ]]; then
        printf 'LTX-2.5 launcher: %s\n' "${ltx25_c1_run_script}"
    else
        printf 'LTX-2.5 collector: %s\n' "${ltx25_run_script}"
    fi
fi

docker_command=(docker "${docker_args[@]}" "${IMAGE}" "${container_command[@]}")
if [[ "${DRY_RUN:-0}" == "1" ]]; then
    printf 'DRY RUN:'
    printf ' %q' "${docker_command[@]}"
    printf '\n'
    exit 0
fi

exec "${docker_command[@]}"
